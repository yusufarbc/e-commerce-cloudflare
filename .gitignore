# ============================================================
# E-Market Monorepo — .gitignore
# ============================================================

# ── Node.js ──────────────────────────────────────────────────
node_modules/
jspm_packages/
web_modules/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── Runtime & Diagnostic ─────────────────────────────────────
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ── Build Outputs ─────────────────────────────────────────────
dist/
build/Release
out/
.next/
.nuxt/
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus/

# ── Cloudflare / Wrangler ────────────────────────────────────
.wrangler/
**/.wrangler/

# ── Environment Variables ─────────────────────────────────────
.env
.env.*
!.env.example

# ── Database & Backup Artifacts ───────────────────────────────
*.sql
*.sql.gz
*.sql.gz.gpg
d1-backup*

# ── Test Coverage ─────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
lib-cov/

# ── Caches ───────────────────────────────────────────────────
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.temp/
.grunt/
.fusebox/

# ── TypeScript ────────────────────────────────────────────────
*.tsbuildinfo

# ── Package Manager Artifacts ─────────────────────────────────
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.yarn-integrity
*.tgz

# ── Vite ─────────────────────────────────────────────────────
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ── Miscellaneous Tools ───────────────────────────────────────
.lock-wscript
.node_repl_history
.tern-port
.vscode-test
bower_components/
.serverless/
.dynamodb/
.firebase/
.vuepress/dist

# ── Agent / AI Tooling ───────────────────────────────────────
skills-lock.json
.agents/

# ── Payment Gateway Integration Samples ──────────────────────
IyzipaySamples.js
PARAM-API-Kullanim-Ornekleri/
