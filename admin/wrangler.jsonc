// Admin SPA (Workers static assets) plus a small Worker that forwards /api/*
// to the API Worker. The custom domains are protected by Cloudflare Access;
// workers.dev and preview URLs are disabled so Access cannot be bypassed.
// Deployed by .github/workflows/devsecops-pipeline.yml with --env staging|production.
{
  "name": "ecommerce-admin",
  "main": "worker/index.js",
  "compatibility_date": "2026-02-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "staging": {
      "name": "ecommerce-admin-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging-admin.ecommerceflaredev.web.tr", "custom_domain": true }],
      "services": [{ "binding": "API", "service": "e-commerce-cloudflare-staging" }]
    },
    "production": {
      "name": "ecommerce-admin-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "admin.ecommerceflaredev.web.tr", "custom_domain": true }],
      "services": [{ "binding": "API", "service": "e-commerce-cloudflare-production" }]
    }
  }
}
